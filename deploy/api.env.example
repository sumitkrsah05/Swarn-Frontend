# Copy to api.env. Environment of the api container (same variables as
# agent2/.env — you can copy your existing agent2/.env over this file).

# ── the model: one OpenAI-compatible endpoint ────────────────────────
SWARN_DEPLOYED_MODEL=qwen38-27b
SWARN_DEPLOYED_BASE_URL=https://your-endpoint.example/openai/v1
SWARN_DEPLOYED_API_KEY=replace-me

# Keys the evaluation feature may reference by NAME (optional)
# GEMMA_API_KEY=
# NVIDIA_API_KEY=

# ── execution ────────────────────────────────────────────────────────
# per-tool-call timeout in seconds
SWARN_EXEC_TIMEOUT=300
# ReAct loop iteration cap
# SWARN_MAX_ITERATIONS=30

# ── logging ──────────────────────────────────────────────────────────
SWARN_LOG_LEVEL=INFO
