# Copy to .env and edit. Read by docker compose (not by the containers).

# The address users type in the browser: the VM's IP or DNS name (no scheme,
# no port). It is baked into the web image and allowed by the API's CORS.
PUBLIC_HOST=172.16.21.108

# Published ports on the VM
WEB_PORT=3000
API_PORT=8420

# Where the agent runs generated code: "subprocess" runs it inside the api
# container (the default here); "docker" needs the Docker socket mounted.
SWARN_SANDBOX=subprocess

# Only for docker-compose.proxy.yml: a domain for automatic HTTPS, or ":80"
# SITE_ADDRESS=:80
